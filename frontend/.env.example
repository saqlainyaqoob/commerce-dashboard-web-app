# Local development: point at the standalone backend.
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# The production Vercel Services deployment is same-origin, so these can
# be omitted in Vercel. The code defaults to /api and window.location.origin.
# VITE_API_URL=/api
# VITE_SOCKET_URL=https://your-deployment.vercel.app
VITE_SOCKET_PATH=/api/socket.io

