# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=commerce_dashboard
PGUSER=postgres
PGPASSWORD=postgres

# Server
PORT=5000
CORS_ORIGIN=http://localhost:5173
# Socket.IO path. In the Vercel Services deployment this is routed through
# the same /api service as the REST API.
SOCKET_IO_PATH=/api/socket.io

# Inventory alert threshold (units) - can be overridden per-product in DB too
LOW_STOCK_THRESHOLD=10

# The one admin account, created by `npm run migrate` (only if it doesn't
# already exist - re-running migrate never overwrites a real password).
# Change the password from the Profile page after your first login.
DEFAULT_ADMIN_NAME=Alex Morgan
DEFAULT_ADMIN_EMAIL=admin@commercehq.io
DEFAULT_ADMIN_PASSWORD=changeme123

# JWT auth - every /api route except /api/auth/* and /api/health
# requires a valid Bearer token signed with this secret. Generate a real
# random value for production, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# This secret must never be sent to or embedded in the frontend build.
JWT_SECRET=replace-with-a-long-random-string-before-deploying

# Access tokens are short-lived (they're just a Bearer header, held in
# frontend memory/localStorage). Sessions are actually kept alive by the
# refresh token below, which is an httpOnly cookie the frontend can't
# read from JS at all.
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

# Set to "production" when deploying behind HTTPS - this makes the
# refresh-token cookie `secure` (HTTPS-only). Leave unset for local dev
# over plain http://localhost.
NODE_ENV=development
